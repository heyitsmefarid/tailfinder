<?php
require_once '../functions.php';
header('Content-Type: application/json');

$conn = connectDB();

parse_str(file_get_contents("php://input"), $_PUT);
$id = intval($_PUT['user_id'] ?? 0);

if (!$id) {
    echo json_encode(["status" => "error", "message" => "User ID required"]);
    exit;
}

try {
    $success = updateUser($conn, $_PUT, $id, $_PUT['new_password'] ?? null);
    echo json_encode(["status" => $success ? "success" : "error", "message" => $success ? "User updated" : "Failed to update"]);
} catch (Exception $e) {
    echo json_encode(["status" => "error", "message" => $e->getMessage()]);
}
